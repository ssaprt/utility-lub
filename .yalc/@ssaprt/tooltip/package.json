{
    "name": "@ssaprt/tooltip",
    "version": "1.0.10",
    "description": "A customizable React tooltip library with rich content, interactive tooltips, animations, SVG surfaces, and built-in themes.",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "sideEffects": [
        "*.css",
        "dist/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./style.css": "./dist/index.css"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "push": "npm run build && npx yalc push"
    },
    "keywords": [
        "tooltip",
        "react",
        "next"
    ],
    "author": "ssaprt (Denis Ukhan)",
    "license": "MIT",
    "type": "commonjs",
    "peerDependencies": {
        "react": ">=18"
    },
    "yalcSig": "fcdc26fbbe8454971855e7b00d205dad"
}
